    <PackageVersion Include="GraphQL.Server.Transports.AspNetCore" Version="8.3.3" />
    <PackageVersion Include="GraphQL.Server.Ui.GraphiQL" Version="8.3.3" />
    <PackageVersion Include="GraphQL.SystemTextJson" Version="8.8.5" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="30.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.191" />
    <PackageVersion Include="Sbom" Version="1.0.0" />
    <PackageVersion Include="Verify.Http" Version="9.0.0" />
    <PackageVersion Include="Verify.XunitV3" Version="33.7.3" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Argon" Version="0.38.2" />
    <PackageVersion Include="DiffEngine" Version="21.2.1" />
    <PackageVersion Include="EmptyFiles" Version="8.20.1" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.1" />
    <PackageVersion Include="Verify" Version="33.7.3" />
  </ItemGroup>
</Project>
